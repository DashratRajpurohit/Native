# EXPO Environment Variables
# If connecting from a physical phone or emulator over Wi-Fi, leave EXPO_PUBLIC_API_URL blank
# to let Expo automatically resolve your host machine's IP (e.g. http://192.168.x.x:5000/api).
# Override only if using a custom backend URL (e.g. https://api.yourdomain.com/api)
EXPO_PUBLIC_API_URL=
